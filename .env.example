# Liquidation Scanner - Environment Variables
# Copy to .env and fill in values before deployment

# Alert destination
ALERT_EMAIL_TARGET=placeholder@local.domain

# SMTP (override config if needed)
# SMTP_SERVER=localhost
# SMTP_PORT=25
# SMTP_PASSWORD=

# eBay API credentials
# EBAY_API_KEY=
# EBAY_APP_ID=

# Logging
# LOG_LEVEL=INFO
